DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_TIME_ZONE=America/Bogota

# DB engine: sqlite|postgres
# Si usas Railway o un servicio Postgres externo, puedes dejar DATABASE_URL y omitir DB_*.
DATABASE_URL=postgresql://postgres:replace-db-password@127.0.0.1:5432/gestion_hotelera
DB_ENGINE=postgres
DB_NAME=gestion_hotelera
DB_USER=postgres
DB_PASSWORD=replace-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS / CSRF for frontend
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
# En desarrollo local con DJANGO_DEBUG=True, estos puertos se agregan automaticamente
# a CORS_ALLOWED_ORIGINS y CSRF_TRUSTED_ORIGINS. Ajusta si Angular abre otro puerto.
DJANGO_LOCAL_FRONTEND_PORTS=4200,4201,63919

# Session / CSRF cookies
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=604800

# HTTPS hardening
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER_ENABLED=True
USE_X_FORWARDED_HOST=True
SECURE_REFERRER_POLICY=same-origin

# Static files
DJANGO_STATIC_ROOT=staticfiles

# Email: transactional email via Resend HTTPS API.
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=re_replace-with-resend-api-key
DEFAULT_FROM_EMAIL=Wayra <onboarding@resend.dev>
SERVER_EMAIL=Wayra <onboarding@resend.dev>
EMAIL_TIMEOUT=20

PASSWORD_RESET_COOKIE_MAX_AGE=1800
ALLOW_PUBLIC_USER_REGISTRATION=False
ALLOW_PUBLIC_CLIENT_REGISTRATION=False
