# Variables requeridas para Railway (servicio web: wayra-gh)
# Copia este bloque en Settings > Variables del servicio web.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=wayra-gh.up.railway.app
DJANGO_TIME_ZONE=America/Bogota

# Opción 1: usar la URL de PostgreSQL que Railway inyecta si agregas el servicio Postgres
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Opción 2: usar variables PG* (compatibilidad directa)
# DB_ENGINE=postgres
# DB_NAME=${{Postgres.PGDATABASE}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}
# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}

# Frontend / CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://wayra-gh.up.railway.app
CSRF_TRUSTED_ORIGINS=https://wayra-gh.up.railway.app

# Seguridad HTTPS / Railway
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=604800
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER_ENABLED=True
USE_X_FORWARDED_HOST=True
SECURE_REFERRER_POLICY=same-origin
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Email
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=replace-with-resend-api-key
DEFAULT_FROM_EMAIL=Wayra <notificaciones@tu-dominio.com>
SERVER_EMAIL=Wayra <notificaciones@tu-dominio.com>
EMAIL_TIMEOUT=20

# Static files
DJANGO_STATIC_ROOT=staticfiles

# Seguridad de registro
ALLOW_PUBLIC_USER_REGISTRATION=False
ALLOW_PUBLIC_CLIENT_REGISTRATION=False
PASSWORD_RESET_COOKIE_MAX_AGE=1800

# Logging
DJANGO_LOG_LEVEL=INFO
